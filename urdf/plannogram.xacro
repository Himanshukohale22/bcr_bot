<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bcr_bot">

    <link name="link_name">
        <visual>
            <geometry>
                <mesh filename="package://pkg_name/meshes/file_name"/>
                <box size="1.0 1.0 1.0" />
                <cylinder radius="1.0" length="1.0"/>
            </geometry>
           
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://pkg_name/meshes/file_name"/>
                <box size="1.0 1.0 1.0" />
                <cylinder radius="1.0" length="1.0"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.0"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
    </link>
    
</robot>
